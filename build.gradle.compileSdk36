plugins {
    id "idea"
    id "com.android.library" apply false
    id "org.jetbrains.kotlin.android" apply false
}

idea.module {
    excludeDirs += file("out")
}

subprojects { subproject ->
    plugins.withId("com.android.base") {
        android {
            compileSdk = 36
            buildToolsVersion = "36.0.0"
            ndkVersion = "29.0.13113456"
            defaultConfig {
                minSdk = 24
                targetSdk = 36
            }
            compileOptions {
                sourceCompatibility = JavaVersion.VERSION_21
                targetCompatibility = JavaVersion.VERSION_21
            }
        }
    }
}

def resolveGitCommitCount = {
    try {
        def proc = ["git", "rev-list", "--count", "HEAD"].execute([], project.rootDir)
        proc.waitFor()
        if (proc.exitValue() == 0) {
            def out = proc.in.text.trim()
            if (out) return Integer.parseInt(out)
        }
    } catch (Throwable ignored) {
    }
    return 1150
}

def gitCommitCount = resolveGitCommitCount()
def baseVersionName = "13.6.0"
def isBeta = project.hasProperty("beta")
ext {
    versionCode = gitCommitCount
    versionName = "${baseVersionName}.r${gitCommitCount}-thedjchi-nightzuku${if (isBeta) "-beta" else ""}"
}
